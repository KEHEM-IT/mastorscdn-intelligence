{
  "name": "mastors-cdn-core-intelligence",
  "displayName": "Mastors CDN Core intelligence",
  "description": "Intelligent SCSS/SASS autocomplete, hover docs, and parameter hints for @mastorscdn/core utility library",
  "version": "1.0.0",
  "publisher": "mastorscdn",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KEHEM-IT/mastorscdn-intelligence.git"
  },
  "homepage": "https://github.com/KEHEM-IT/mastorscdn-intelligence",
  "bugs": {
    "url": "https://github.com/KEHEM-IT/mastorscdn-intelligence/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "scss",
    "sass",
    "mastors",
    "mastorscdn",
    "intelligence",
    "autocomplete",
    "design tokens"
  ],
  "activationEvents": [
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:css",
    "workspaceContains:**/*.scss",
    "workspaceContains:**/*.sass",
    "workspaceContains:**/*.css"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Mastors CDN intelligence",
      "properties": {
        "mastorsintelligence.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mastors CDN intelligence"
        },
        "mastorsintelligence.corePackagePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to @mastorscdn/core SCSS root (leave empty to auto-detect from node_modules or workspace)"
        },
        "mastorsintelligence.showParameterHints": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter hints for Mastors functions"
        },
        "mastorsintelligence.enableFuzzySearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable fuzzy search in completions"
        },
        "mastorsintelligence.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Cache the parsed registry to disk for faster startup"
        },
        "mastorsintelligence.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug-level logging in the Mastors intelligence output channel"
        },
        "mastorsintelligence.scanWorkspacePath": {
          "type": "string",
          "default": "",
          "description": "Additional absolute path to scan for Mastors Core SCSS files (useful for monorepos)"
        }
      }
    },
    "commands": [
      {
        "command": "mastorsintelligence.refreshRegistry",
        "title": "Mastors: Refresh Function Registry"
      },
      {
        "command": "mastorsintelligence.showRegistry",
        "title": "Mastors: Show Registry"
      },
      {
        "command": "mastorsintelligence.clearCache",
        "title": "Mastors: Clear Cache"
      },
      {
        "command": "mastorsintelligence.generateRegistry",
        "title": "Mastors: Generate Registry JSON"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mastorsintelligence.refreshRegistry",
          "when": "editorLangId == scss || editorLangId == sass"
        },
        {
          "command": "mastorsintelligence.showRegistry"
        },
        {
          "command": "mastorsintelligence.clearCache"
        },
        {
          "command": "mastorsintelligence.generateRegistry"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "package": "vsce package",
    "generate-registry": "ts-node scripts/generateRegistry.ts",
    "sync-registry": "ts-node scripts/syncFromCore.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "fuse.js": "^7.0.0"
  }
}
